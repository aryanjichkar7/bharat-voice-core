# ==============================================================================
# Bharat Online Cabs — Environment Configuration
# Free OpenStreetMap Geospatial Stack (No Paid API Keys Required)
# ==============================================================================

# Geospatial Provider Configuration
MAP_PROVIDER=osm
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_GEOCODER_URL=https://nominatim.openstreetmap.org/search
OSM_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
OSM_ROUTING_URL=http://router.project-osrm.org/route/v1/driving

# Default Dispatch Coordinates (Nagpur, Maharashtra)
DEFAULT_CITY="Nagpur, Maharashtra"
DEFAULT_LAT=21.1458
DEFAULT_LON=79.0882

# Local AI Engine Settings
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:3b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
VAD_STOP_SECS=0.9

# Tariff Parameters (Source of Truth)
# BASE_FARE_INR=50.0
# PER_KM_INR=14.0
# MIN_FARE_INR=70.0

# Optional / Deprecated Legacy Keys (Not required for active execution)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_BROWSER_API_KEY=
